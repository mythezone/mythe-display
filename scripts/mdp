#!/usr/bin/env bash
set -euo pipefail

DEFAULT_ROOT="${MYTHE_DISPLAY_DEFAULT_ROOT:-/opt/mythe-display}"

resolve_root() {
  local source="${BASH_SOURCE[0]}"
  local dir=""

  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done

  dir="$(cd -P "$(dirname "$source")" && pwd)"
  if [[ -f "$dir/kiosk-control.py" && -f "$dir/run-kiosk-web-test.sh" ]]; then
    cd "$dir/.." && pwd
    return 0
  fi
  if [[ -f "$dir/scripts/kiosk-control.py" ]]; then
    cd "$dir" && pwd
    return 0
  fi
  if [[ -n "${MYTHE_DISPLAY_ROOT:-}" && -f "$MYTHE_DISPLAY_ROOT/scripts/kiosk-control.py" ]]; then
    cd "$MYTHE_DISPLAY_ROOT" && pwd
    return 0
  fi
  if [[ -f "$DEFAULT_ROOT/scripts/kiosk-control.py" ]]; then
    cd "$DEFAULT_ROOT" && pwd
    return 0
  fi
  echo "找不到 Mythe Display 仓库。请设置 MYTHE_DISPLAY_ROOT=/path/to/mythe-display。" >&2
  return 1
}

ROOT_DIR="$(resolve_root)"
if [[ -f "$ROOT_DIR/scripts/load-env.sh" ]]; then
  # shellcheck source=scripts/load-env.sh
  source "$ROOT_DIR/scripts/load-env.sh"
  load_mythe_display_env_defaults "$ROOT_DIR/.env"
fi

UNIT_NAME="${MYTHE_DISPLAY_UNIT_NAME:-mythe-display-kiosk}"
CONTROL_WAIT_SECONDS="${MYTHE_DISPLAY_CONTROL_WAIT_SECONDS:-18}"
CONTROL="$ROOT_DIR/scripts/kiosk-control.py"
RUN_KIOSK="$ROOT_DIR/scripts/run-kiosk-web-test.sh"
INSTALL_SERVICE="$ROOT_DIR/scripts/install-kiosk-service.sh"
INSTALL_COMMAND="$ROOT_DIR/scripts/install-mdp-command.sh"
PET_IMPORT="$ROOT_DIR/scripts/import-codex-pet.py"
AUDIO_TEST="$ROOT_DIR/scripts/audio-output-test.sh"
INSTALL_EDID="$ROOT_DIR/scripts/install-edid-override.sh"

usage() {
  cat <<EOF
Usage:
  mdp <command> [args]

Display:
  mdp reload                       刷新当前 kiosk 页面，不重启服务
  mdp switch <url>                 切换当前 kiosk 页面
  mdp open <url>                   打开新页面并保留旧 page target
  mdp list                         列出 Chromium page target
  mdp current                      查看当前页面
  mdp theme <theme-json-url>       切换到指定主题资源包
  mdp pet <package|id|zip>         导入 Codex/Petdex pet 包并刷新
  mdp audio-test [device] [secs]   输出一段 ALSA 测试音

Service:
  mdp start                        启动 systemd kiosk 服务
  mdp stop                         停止 systemd kiosk 服务
  mdp restart                      重启 systemd kiosk 服务
  mdp status                       查看 systemd 服务状态
  mdp enable                       设置开机自启
  mdp disable                      取消开机自启
  mdp logs                         跟随查看服务日志

Setup:
  mdp install-service              安装/更新 systemd 服务
  mdp install-command              安装/更新 /usr/bin/mdp
  mdp install-edid                 安装当前长条屏的固定 3840x1100 EDID
  mdp run [url]                    直接运行 kiosk 测试脚本

Examples:
  mdp reload
  mdp switch /kiosk-test/
  mdp switch 'https://example.com'
  mdp theme ../themes/neon-dark/theme.json
  mdp pet ~/.codex/pets/example
  sudo mdp audio-test plughw:0,3
EOF
}

systemctl_as_needed() {
  local action="$1"
  shift || true
  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    systemctl "$action" "$UNIT_NAME" "$@"
  else
    sudo systemctl "$action" "$UNIT_NAME" "$@"
  fi
}

run_root() {
  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

service_exists() {
  systemctl cat "$UNIT_NAME" >/dev/null 2>&1
}

service_is_active() {
  systemctl is-active --quiet "$UNIT_NAME" >/dev/null 2>&1
}

ensure_service_installed() {
  if service_exists; then
    return 0
  fi

  echo "未发现 ${UNIT_NAME}.service，正在安装 systemd 服务..." >&2
  run_root "$INSTALL_SERVICE" >/dev/null
  systemctl daemon-reload >/dev/null 2>&1 || true

  if ! service_exists; then
    echo "服务安装后仍无法发现 ${UNIT_NAME}.service。请检查 $ROOT_DIR/systemd/mythe-display-kiosk.service。" >&2
    exit 1
  fi
}

ensure_service_started() {
  ensure_service_installed
  if service_is_active; then
    return 0
  fi

  echo "${UNIT_NAME}.service 未运行，正在启动..." >&2
  systemctl_as_needed start >/dev/null
}

wait_for_control() {
  local deadline=$((SECONDS + CONTROL_WAIT_SECONDS))
  while (( SECONDS < deadline )); do
    if "$CONTROL" list --json >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

control_with_service() {
  local command="$1"
  shift || true

  if "$CONTROL" list --json >/dev/null 2>&1; then
    exec "$CONTROL" "$command" "$@"
  fi

  ensure_service_started
  if wait_for_control; then
    exec "$CONTROL" "$command" "$@"
  fi

  echo "kiosk 服务已启动，但 Chromium DevTools 控制端口仍不可用。" >&2
  echo "请查看服务状态和日志：" >&2
  echo "  mdp status" >&2
  echo "  mdp logs" >&2
  exit 1
}

show_status() {
  if ! service_exists; then
    cat >&2 <<EOF
未发现 ${UNIT_NAME}.service。

首次使用请运行：
  mdp install-service

或者直接运行：
  mdp start

mdp start 会自动安装服务并启动。
EOF
    return 3
  fi
  systemctl status "$UNIT_NAME" "$@"
}

show_logs() {
  if ! service_exists; then
    echo "未发现 ${UNIT_NAME}.service。请先运行 mdp install-service 或 mdp start。" >&2
    return 3
  fi
  journalctl -u "$UNIT_NAME" -f "$@"
}

case "${1:-help}" in
  help|-h|--help)
    usage
    ;;
  reload|refresh)
    shift
    control_with_service reload "$@"
    ;;
  switch)
    shift
    control_with_service switch "$@"
    ;;
  open)
    shift
    control_with_service open "$@"
    ;;
  list)
    shift
    exec "$CONTROL" list "$@"
    ;;
  current)
    shift
    exec "$CONTROL" current "$@"
    ;;
  theme)
    shift
    if [[ -z "${1:-}" ]]; then
      echo "用法: mdp theme <theme-json-url>" >&2
      exit 2
    fi
    control_with_service switch "/kiosk-test/?theme=$1" --cache-bust
    ;;
  pet)
    shift
    if [[ -z "${1:-}" ]]; then
      echo "用法: mdp pet <package|id|zip> [--force]" >&2
      exit 2
    fi
    "$PET_IMPORT" "$@"
    if "$CONTROL" list --json >/dev/null 2>&1; then
      "$CONTROL" reload || true
    else
      echo "pet 已导入。kiosk 未运行时，之后执行 mdp start；正在运行时可执行 mdp reload。" >&2
    fi
    ;;
  audio-test)
    shift
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
      exec "$AUDIO_TEST" "$@"
    fi
    exec sudo "$AUDIO_TEST" "$@"
    ;;
  control)
    shift
    exec "$CONTROL" "$@"
    ;;
  run)
    shift
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
      exec "$RUN_KIOSK" "$@"
    fi
    exec sudo "$RUN_KIOSK" "$@"
    ;;
  start|stop|restart|enable|disable)
    action="$1"
    shift
    if [[ "$action" == "start" || "$action" == "restart" || "$action" == "enable" ]]; then
      ensure_service_installed
    fi
    systemctl_as_needed "$action" "$@"
    ;;
  status)
    shift
    show_status "$@"
    ;;
  logs|log)
    shift
    show_logs "$@"
    ;;
  install-service)
    shift
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
      exec "$INSTALL_SERVICE" "$@"
    fi
    exec sudo "$INSTALL_SERVICE" "$@"
    ;;
  install-command)
    shift
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
      exec "$INSTALL_COMMAND" "$@"
    fi
    exec sudo "$INSTALL_COMMAND" "$@"
    ;;
  install-edid)
    shift
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
      exec "$INSTALL_EDID" "$@"
    fi
    exec sudo "$INSTALL_EDID" "$@"
    ;;
  *)
    echo "未知命令: $1" >&2
    usage >&2
    exit 2
    ;;
esac
