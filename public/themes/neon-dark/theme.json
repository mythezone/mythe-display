{
  "id": "core.neon-dark",
  "name": "Neon Dark",
  "version": "0.6.0",
  "description": "适合 3840x1100 长条副屏的暗色霓虹资源包。",
  "tokens": {
    "surface.canvas": "#05070a",
    "surface.panel": "rgba(18, 22, 30, 0.84)",
    "surface.panelMuted": "rgba(18, 22, 30, 0.56)",
    "text.primary": "#f4f7fb",
    "text.secondary": "#a8b3c7",
    "text.muted": "#657086",
    "accent.primary": "#0a84ff",
    "accent.secondary": "#bf5af2",
    "metric.good": "#30d158",
    "metric.warn": "#ffd60a",
    "metric.bad": "#ff453a",
    "border.subtle": "rgba(255,255,255,0.12)",
    "shadow.panel": "0 18px 60px rgba(0,0,0,0.34)"
  },
  "wallpaper": {
    "fallback": "#05070a",
    "layers": [
      {
        "id": "circuit-grid",
        "src": "backgrounds/circuit-grid.svg",
        "opacity": 0.72,
        "blendMode": "screen",
        "animation": "drift-slow"
      },
      {
        "id": "pixel-stars",
        "src": "backgrounds/pixel-stars.svg",
        "opacity": 0.46,
        "blendMode": "screen",
        "animation": "drift-medium"
      },
      {
        "id": "neon-rings",
        "src": "backgrounds/neon-rings.svg",
        "opacity": 0.62,
        "blendMode": "screen",
        "animation": "pulse"
      }
    ],
    "effects": ["scanlines", "vignette"]
  },
  "hero": {
    "logo": "hero/mythenas-core.png",
    "background": {
      "engine": "canvas-triangle-mesh",
      "pointCount": "auto",
      "motion": "slow"
    }
  },
  "mascot": {
    "assistant": "mascot/assistant.png",
    "actions": [
      { "action": "idle", "quote": "稳定先于华丽。" },
      { "action": "wave", "quote": "先备份，再冒险。" },
      { "action": "think", "quote": "慢查询不会自己消失。" },
      { "action": "scan", "quote": "每一次告警都值得被解释。" },
      { "action": "celebrate", "quote": "自动化省下的时间，应该还给思考。" },
      { "action": "patrol", "quote": "巡检不是仪式，是发现变化。" },
      { "action": "focus", "quote": "先看趋势，再判断噪声。" },
      { "action": "sleep", "quote": "低负载时也要保持清醒的日志。" },
      { "action": "type", "quote": "配置写清楚，服务少猜测。" },
      { "action": "guard", "quote": "守住边界，比补救更可靠。" },
      { "action": "alert", "quote": "异常出现时，先保留证据。" },
      { "action": "boot", "quote": "启动链路越短，恢复越快。" },
      { "action": "nod", "quote": "确认之后再切换。" }
    ],
    "codexPet": {
      "enabled": false,
      "manifest": "mascot/pets/<pet-id>/pet.json",
      "columns": 8,
      "rows": 9,
      "frameWidth": 192,
      "frameHeight": 208,
      "frames": 8,
      "fps": 9,
      "scale": 1.05,
      "actionRows": {
        "idle": 0,
        "patrol": 7,
        "wave": 3,
        "celebrate": 4,
        "think": 6,
        "scan": 8,
        "focus": 8,
        "sleep": 6,
        "type": 8,
        "guard": 5,
        "alert": 5,
        "boot": 4,
        "nod": 0
      }
    },
    "rive": {
      "enabled": false,
      "src": "",
      "runtime": "https://unpkg.com/@rive-app/canvas@2.21.0/rive.js",
      "stateMachine": ""
    }
  },
  "sprites": {
    "agent": {
      "idle": "sprites/agent-idle.svg",
      "walking": "sprites/agent-walking.svg",
      "working": "sprites/agent-working.svg",
      "thinking": "sprites/agent-thinking.svg",
      "building": "sprites/agent-building.svg",
      "reviewing": "sprites/agent-reviewing.svg",
      "blocked": "sprites/agent-blocked.svg",
      "error": "sprites/agent-error.svg",
      "offline": "sprites/agent-offline.svg"
    }
  }
}
