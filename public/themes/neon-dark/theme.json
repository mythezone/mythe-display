{
  "id": "core.neon-dark",
  "name": "Neon Dark",
  "version": "0.6.0",
  "description": "适合 3840x1100 长条副屏的暗色霓虹资源包。",
  "tokens": {
    "surface.canvas": "#05070a",
    "surface.panel": "rgba(18, 22, 30, 0.84)",
    "surface.panelMuted": "rgba(18, 22, 30, 0.56)",
    "text.primary": "#f4f7fb",
    "text.secondary": "#a8b3c7",
    "text.muted": "#657086",
    "accent.primary": "#0a84ff",
    "accent.secondary": "#bf5af2",
    "metric.good": "#30d158",
    "metric.warn": "#ffd60a",
    "metric.bad": "#ff453a",
    "border.subtle": "rgba(255,255,255,0.12)",
    "shadow.panel": "0 18px 60px rgba(0,0,0,0.34)"
  },
  "wallpaper": {
    "fallback": "#05070a",
    "layers": [
      {
        "id": "circuit-grid",
        "src": "backgrounds/circuit-grid.svg",
        "opacity": 0.72,
        "blendMode": "screen",
        "animation": "drift-slow"
      },
      {
        "id": "pixel-stars",
        "src": "backgrounds/pixel-stars.svg",
        "opacity": 0.46,
        "blendMode": "screen",
        "animation": "drift-medium"
      },
      {
        "id": "neon-rings",
        "src": "backgrounds/neon-rings.svg",
        "opacity": 0.62,
        "blendMode": "screen",
        "animation": "pulse"
      }
    ],
    "effects": ["scanlines", "vignette"]
  },
  "hero": {
    "logo": "hero/mythenas-core.png",
    "background": {
      "engine": "canvas-triangle-mesh",
      "pointCount": "auto",
      "motion": "slow"
    }
  },
  "mascot": {
    "actions": [
      {"action": "idle", "when": "idle", "quote": "暂时没有任务，休息一会儿。"},
      {"action": "wave", "when": "idle", "quote": "你好呀，有事叫我就好。"},
      {"action": "waiting", "when": "idle", "quote": "我会在这里等你。"},
      {"action": "review", "when": "working", "quote": "我在认真检查，稍等一下。"},
      {"action": "running", "when": "working", "quote": "正在赶往下一项任务。"},
      {"action": "waiting", "when": "unknown", "quote": "正在确认工作状态。"}
    ],
    "codexPet": {
      "enabled": true,
      "source": "chatgpt",
      "manifest": "mascot/pets/chatgpt-frieren/pet.json",
      "columns": 8,
      "rows": 9,
      "frameWidth": 192,
      "frameHeight": 208,
      "frames": 8,
      "fps": 3,
      "scale": 1.3,
      "actionRows": {
        "idle": 0,
        "wave": 3,
        "jump": 4,
        "celebrate": 4,
        "review": 8,
        "running": 7,
        "waiting": 6
      }
    },
    "rive": {
      "enabled": false,
      "src": "",
      "runtime": "https://unpkg.com/@rive-app/canvas@2.21.0/rive.js",
      "stateMachine": ""
    }
  },
  "sprites": {
    "agent": {
      "idle": "sprites/agent-idle.svg",
      "walking": "sprites/agent-walking.svg",
      "working": "sprites/agent-working.svg",
      "thinking": "sprites/agent-thinking.svg",
      "building": "sprites/agent-building.svg",
      "reviewing": "sprites/agent-reviewing.svg",
      "blocked": "sprites/agent-blocked.svg",
      "error": "sprites/agent-error.svg",
      "offline": "sprites/agent-offline.svg"
    }
  }
}
