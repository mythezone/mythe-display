[Unit]
Description=Mythe Display kiosk web runtime
Documentation=https://gitlab.muiao.com/mythe/mythe-display
After=network-online.target snapd.service systemd-logind.service mythe-display-hotplug.service
Wants=network-online.target mythe-display-hotplug.service

[Service]
Type=simple
WorkingDirectory=__MYTHE_DISPLAY_ROOT__
Environment=MYTHE_DISPLAY_HOST=127.0.0.1
Environment=MYTHE_DISPLAY_PORT=23456
Environment=MYTHE_DISPLAY_REMOTE_DEBUG_PORT=23458
Environment=LIBSEAT_BACKEND=builtin
Environment=WLR_BACKENDS=drm
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=MYTHE_DISPLAY_DRM_DEVICE=auto
Environment=MYTHE_DISPLAY_DRM_MODE=3840x1100
Environment=MYTHE_DISPLAY_DRM_MODE_STRICT=0
Environment=MYTHE_DISPLAY_DRM_READY_STABLE_MS=2000
Environment=MYTHE_DISPLAY_DRM_READY_TIMEOUT_MS=20000
Environment=MYTHE_DISPLAY_DISABLE_DRM_ATOMIC=1
Environment=MYTHE_DISPLAY_DISABLE_DRM_MODIFIERS=1
Environment=MYTHE_DISPLAY_BROWSER=chromium-browser
EnvironmentFile=-__MYTHE_DISPLAY_ROOT__/.env
ExecStart=__MYTHE_DISPLAY_ROOT__/scripts/run-kiosk-web-test.sh
ExecReload=__MYTHE_DISPLAY_ROOT__/scripts/kiosk-control.py reload
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
