# Mythe Display local environment template.
# Mythe Display 本地环境变量模板。
#
# Copy this file to .env when you need machine-specific overrides.
# 需要本机覆盖项时复制为 .env。
#
# Do not commit .env, API tokens, private hostnames, personal paths, or secrets.
# 不要提交 .env、API token、私有主机名、个人路径或任何密钥。

# Local static Web server bind address.
# 本地静态 Web 服务监听地址。headless kiosk 推荐保持 127.0.0.1。
MYTHE_DISPLAY_HOST=127.0.0.1

# Local static Web server port used by preview and kiosk runtime.
# 本地预览和 kiosk 运行时端口。
MYTHE_DISPLAY_PORT=23456

# Chromium DevTools host used by mdp control commands.
# mdp 控制命令使用的 Chromium DevTools 主机。
MYTHE_DISPLAY_REMOTE_DEBUG_HOST=127.0.0.1

# Chromium DevTools control port used by mdp reload/switch/current/list.
# mdp reload/switch/current/list 使用的 Chromium DevTools 控制端口。
MYTHE_DISPLAY_REMOTE_DEBUG_PORT=23458

# Browser executable used by scripts/run-kiosk-web-test.sh.
# scripts/run-kiosk-web-test.sh 使用的浏览器命令。
MYTHE_DISPLAY_BROWSER=chromium-browser

# DRM card used by Cage/wlroots. Use auto to select the card that owns a
# connected display connector. This avoids failures when Linux reorders
# /dev/dri/card0 and /dev/dri/card1 after reboot.
# Cage/wlroots 使用的 DRM 设备路径。auto 会选择带 connected 显示连接器的 card，
# 避免重启后 /dev/dri/card0 与 /dev/dri/card1 顺序变化导致启动失败。
MYTHE_DISPLAY_DRM_DEVICE=auto

# Set to 1 to force MYTHE_DISPLAY_DRM_DEVICE even if another card has the
# connected display connector.
# 设为 1 时强制使用 MYTHE_DISPLAY_DRM_DEVICE，不自动切换到 connected card。
MYTHE_DISPLAY_DRM_DEVICE_STRICT=0

# Disable wlroots atomic KMS in direct DRM mode. This is enabled by default
# because some long-bar HDMI displays/i915 combinations can freeze after
# repeated atomic commit failures.
# 在 direct DRM 模式下禁用 wlroots atomic KMS。默认开启，因为部分长条屏/i915
# 组合会在反复 atomic commit 失败后出现画面卡住。
MYTHE_DISPLAY_DISABLE_DRM_ATOMIC=1

# Disable DRM modifiers in direct DRM mode for better compatibility.
# 在 direct DRM 模式下禁用 DRM modifiers，提高兼容性。
MYTHE_DISPLAY_DISABLE_DRM_MODIFIERS=1

# Set to 1 to skip runtime data collectors and use existing/mock data.
# 设为 1 可跳过运行时采集器，使用已有 runtime 或 mock 数据。
MYTHE_DISPLAY_DISABLE_RUNTIME_COLLECTOR=0

# Disk snapshot refresh interval in milliseconds. Default: 12 hours.
# 磁盘快照刷新间隔，单位毫秒。默认 12 小时。
MYTHE_DISPLAY_DISK_REFRESH_MS=43200000

# CPU, memory, and network snapshot refresh interval in milliseconds.
# CPU、内存和网络快照刷新间隔，单位毫秒。
MYTHE_DISPLAY_TELEMETRY_REFRESH_MS=600000

# Docker snapshot refresh interval in milliseconds.
# Docker 快照刷新间隔，单位毫秒。
MYTHE_DISPLAY_DOCKER_REFRESH_MS=600000

# Shenzhen weather snapshot refresh interval in milliseconds.
# 深圳天气快照刷新间隔，单位毫秒。
MYTHE_DISPLAY_WEATHER_REFRESH_MS=1800000

# Local Codex Agent snapshot refresh interval in milliseconds.
# 本机 Codex Agent 快照刷新间隔，单位毫秒。
MYTHE_DISPLAY_AGENTS_REFRESH_MS=300000

# Show Codex thread titles on the physical screen.
# 设为 1 才会在物理屏幕上显示 Codex 线程标题；默认避免泄露工作内容。
MYTHE_DISPLAY_CODEX_AGENT_SHOW_THREAD_NAMES=0

# Optional future provider tokens. Leave empty unless a custom widget requires them.
# 未来自定义数据源可能使用的 token；没有明确需要时保持为空。
GITHUB_TOKEN=
