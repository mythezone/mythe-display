# Mythe Display local environment template.
# Mythe Display 本地环境变量模板。
#
# Copy this file to .env when you need machine-specific overrides.
# 需要本机覆盖项时复制为 .env。
#
# Do not commit .env, API tokens, private hostnames, personal paths, or secrets.
# 不要提交 .env、API token、私有主机名、个人路径或任何密钥。

# Local static Web server bind address.
# 本地静态 Web 服务监听地址。headless kiosk 推荐保持 127.0.0.1。
MYTHE_DISPLAY_HOST=127.0.0.1

# Local static Web server port used by preview and kiosk runtime.
# 本地预览和 kiosk 运行时端口。
MYTHE_DISPLAY_PORT=23456

# Chromium DevTools host used by mdp control commands.
# mdp 控制命令使用的 Chromium DevTools 主机。
MYTHE_DISPLAY_REMOTE_DEBUG_HOST=127.0.0.1

# Chromium DevTools control port used by mdp reload/switch/current/list.
# mdp reload/switch/current/list 使用的 Chromium DevTools 控制端口。
MYTHE_DISPLAY_REMOTE_DEBUG_PORT=23458

# Browser executable used by scripts/run-kiosk-web-test.sh.
# scripts/run-kiosk-web-test.sh 使用的浏览器命令。
MYTHE_DISPLAY_BROWSER=chromium-browser

# Chromium ALSA output device. The current NAS defaults to the connected HDMI
# display audio endpoint.
# Examples on the current NAS:
#   plughw:0,3 = connected HDMI display audio endpoint with ALSA format conversion
#   hw:0,0 = motherboard analog audio jack
# Chromium ALSA 输出设备。当前 NAS 默认使用在线 HDMI 副屏音频端点。
# 当前 NAS 示例：
#   plughw:0,3 = 当前在线 HDMI 副屏音频端点，并由 ALSA 做格式转换
#   hw:0,0 = 主板模拟音频口
MYTHE_DISPLAY_ALSA_OUTPUT_DEVICE=plughw:0,3

# DRM card used by Cage/wlroots. Use auto to select the card that owns a
# connected display connector. This avoids failures when Linux reorders
# /dev/dri/card0 and /dev/dri/card1 after reboot.
# Cage/wlroots 使用的 DRM 设备路径。auto 会选择带 connected 显示连接器的 card，
# 避免重启后 /dev/dri/card0 与 /dev/dri/card1 顺序变化导致启动失败。
MYTHE_DISPLAY_DRM_DEVICE=auto

# Set to 1 to force MYTHE_DISPLAY_DRM_DEVICE even if another card has the
# connected display connector.
# 设为 1 时强制使用 MYTHE_DISPLAY_DRM_DEVICE，不自动切换到 connected card。
MYTHE_DISPLAY_DRM_DEVICE_STRICT=0

# Optional DRM connector to watch for hotplug recovery, such as HDMI-A-2 or
# card1-HDMI-A-2. Keep empty to monitor whichever connector is connected.
# 可选的热插拔监测 connector，例如 HDMI-A-2 或 card1-HDMI-A-2。保持为空时，
# 自动监测所有已连接 connector。
MYTHE_DISPLAY_DRM_CONNECTOR=

# Required output mode. Change this for a display with another native size.
# 启动和热插拔恢复时要求 EDID 包含此模式；其他尺寸屏幕请修改。
MYTHE_DISPLAY_DRM_MODE=3840x1100

# DRM hotplug recovery requires a valid, unchanged EDID and the target mode
# throughout this stabilization interval.
# 热插拔后需等待 EDID 校验通过、内容不再变化且包含目标模式。
MYTHE_DISPLAY_HOTPLUG_POLL_MS=1000
MYTHE_DISPLAY_HOTPLUG_STABLE_MS=8000

# Every kiosk start also waits briefly for a stable DRM output. This prevents
# Cage from starting while HDMI EDID is still corrupt during cable insertion.
# 每次 kiosk 启动前的 DRM 就绪门禁，可按硬件响应速度调整。
MYTHE_DISPLAY_WAIT_FOR_DRM_READY=1
MYTHE_DISPLAY_DRM_READY_STABLE_MS=2000
MYTHE_DISPLAY_DRM_READY_TIMEOUT_MS=20000

# Disable wlroots atomic KMS in direct DRM mode. This is enabled by default
# because some long-bar HDMI displays/i915 combinations can freeze after
# repeated atomic commit failures.
# 在 direct DRM 模式下禁用 wlroots atomic KMS。默认开启，因为部分长条屏/i915
# 组合会在反复 atomic commit 失败后出现画面卡住。
MYTHE_DISPLAY_DISABLE_DRM_ATOMIC=1

# Disable DRM modifiers in direct DRM mode for better compatibility.
# 在 direct DRM 模式下禁用 DRM modifiers，提高兼容性。
MYTHE_DISPLAY_DISABLE_DRM_MODIFIERS=1

# Set to 1 to skip runtime data collectors and use existing/mock data.
# 设为 1 可跳过运行时采集器，使用已有 runtime 或 mock 数据。
MYTHE_DISPLAY_DISABLE_RUNTIME_COLLECTOR=0

# Add an assetCacheBust query parameter when starting the default local kiosk
# page. Keep enabled so Chromium does not restore stale HTML from its profile.
# 启动默认本地 kiosk 页面时追加 assetCacheBust 查询参数。建议保持开启，
# 避免 Chromium 从 profile 中恢复旧 HTML。
MYTHE_DISPLAY_START_CACHE_BUST=1

# Disk snapshot refresh interval in milliseconds. Default: 12 hours.
# 磁盘快照刷新间隔，单位毫秒。默认 12 小时。
MYTHE_DISPLAY_DISK_REFRESH_MS=43200000

# CPU, memory, and network snapshot refresh interval in milliseconds.
# CPU、内存和网络快照刷新间隔，单位毫秒。
MYTHE_DISPLAY_TELEMETRY_REFRESH_MS=600000

# Docker snapshot refresh interval in milliseconds.
# Docker 快照刷新间隔，单位毫秒。
MYTHE_DISPLAY_DOCKER_REFRESH_MS=600000

# Shenzhen weather snapshot refresh interval in milliseconds.
# 深圳天气快照刷新间隔，单位毫秒。
MYTHE_DISPLAY_WEATHER_REFRESH_MS=1800000

# Local Codex Agent snapshot refresh interval in milliseconds.
# 本机 Codex Agent 快照刷新间隔，单位毫秒。
MYTHE_DISPLAY_AGENTS_REFRESH_MS=300000

# FAIO listening-room snapshot refresh interval in milliseconds.
# FAIO 一起听歌房间快照刷新间隔，单位毫秒。副屏需要较快刷新以跟随播放状态。
MYTHE_DISPLAY_FAIO_LISTEN_REFRESH_MS=10000

# FAIO listening-room URL. The default uses the local FAIO webapp proxy on
# the same server instead of the public domain.
# FAIO 一起听歌房间地址。默认使用同一台服务器上的本地 FAIO Webapp 代理，
# 不走公网域名。
MYTHE_DISPLAY_FAIO_LISTEN_ROOM_URL=http://127.0.0.1:4173/listen/XatSqhcP6LmROQyKrjCULXyD-zcynwRZO5QaLO5Oeyg

# Display name used by the read-only kiosk listener when joining the room.
# 副屏只读听众加入房间时使用的显示名。
MYTHE_DISPLAY_FAIO_LISTEN_DISPLAY_NAME="MytheNAS Speaker"

# Optional passcode when the kiosk listener nickname has been locked.
MYTHE_DISPLAY_FAIO_LISTEN_PASSCODE=

# Private FAIO music-room session metadata path. Keep this under tmp/ or
# another ignored/private directory; never commit the generated file.
# FAIO 房间 session 私有元数据路径。请保持在 tmp/ 或其他被忽略的私有目录中；
# 不要提交生成文件。
MYTHE_DISPLAY_FAIO_SESSION_FILE=tmp/faio-listen-session.json
# Public playback pause and volume use a lightweight poll without reloading the track.
MYTHE_DISPLAY_FAIO_PUBLIC_OUTPUT_REFRESH_MS=1000

# Set to 1 to disable FAIO listening-room collection.
# 设为 1 可禁用 FAIO 一起听歌采集。
MYTHE_DISPLAY_DISABLE_FAIO_LISTEN=0

# Set to 1 to disable the FFmpeg/ALSA FAIO audio follower. It is enabled by
# default because headless snap Chromium may not open ALSA PCM devices even
# when its HTML audio element reports playing.
# 设为 1 可禁用 FFmpeg/ALSA FAIO 独立音频跟随播放器。默认启用，因为无桌面
# snap Chromium 可能显示 HTML audio 正在播放，但实际不打开 ALSA PCM 设备。
MYTHE_DISPLAY_DISABLE_FAIO_AUDIO_PLAYER=0

# FAIO audio follower poll interval in milliseconds.
# FAIO 独立音频播放器读取房间快照的间隔，单位毫秒。
MYTHE_DISPLAY_FAIO_AUDIO_POLL_MS=1000

# Set to 1 to keep browser-side FAIO audio enabled even when the independent
# FFmpeg/ALSA player is running. Default 0 avoids double playback.
# 设为 1 可在独立音频播放器运行时仍启用浏览器内置 FAIO audio。默认 0 避免双重播放。
MYTHE_DISPLAY_FAIO_BROWSER_AUDIO=0

# Show Codex thread titles on the physical screen.
# 设为 1 才会在物理屏幕上显示 Codex 线程标题；默认避免泄露工作内容。
MYTHE_DISPLAY_CODEX_AGENT_SHOW_THREAD_NAMES=0

# Optional future provider tokens. Leave empty unless a custom widget requires them.
# 未来自定义数据源可能使用的 token；没有明确需要时保持为空。
GITHUB_TOKEN=
